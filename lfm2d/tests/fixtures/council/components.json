     },
     "type": {
      "const": "text"
     }
    },
    "required": [
     "id",
     "type",
     "instructions",
     "max_tokens"
    ],
    "type": "object"
   },
   "Turn": {
    "additionalProperties": false,
    "if": {
     "required": [
      "reasoning"
     ]
    },
    "properties": {
     "content": {
      "description": "Tokenized with special tokens off; text that spells a control token is text.",
      "type": "string"
     },
     "reasoning": {
      "description": "The model's own thinking for an assistant turn, rendered as that turn's thinking and part of the context's content. Assistant turns only; absent and empty render the same empty thinking region.",
      "type": "string"
     },
     "role": {
      "enum": [
       "user",
       "assistant",
       "tool"
      ],
      "type": "string"
     },
     "snap": {
      "default": false,
      "description": "Keep a snapshot boundary at the end of this turn. Part of the context's content.",
      "type": "boolean"
     }
    },
    "required": [
     "role",
     "content"
    ],
    "then": {
     "properties": {
      "role": {
       "const": "assistant"
      }
     }
    },
    "type": "object"
   }
  }

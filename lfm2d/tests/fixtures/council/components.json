   },
   "SpecTextQuestion": {
    "additionalProperties": false,
    "description": "Written greedily before the questions after it, stopping at the end of the field. Requires the describe capability.",
    "properties": {
     "id": {
      "$ref": "#/components/schemas/QuestionId"
     },
     "instructions": {
      "$ref": "#/components/schemas/Instructions"
     },
     "max_tokens": {
      "description": "At most identity.limits.text_tokens.",
      "minimum": 1,

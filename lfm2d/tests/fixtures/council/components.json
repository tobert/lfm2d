     {
      "$ref": "#/components/schemas/SpecChoiceQuestion"
     },
     {
      "$ref": "#/components/schemas/SpecScoreQuestion"
     },
     {
      "$ref": "#/components/schemas/SpecNoulQuestion"
     },
     {
      "$ref": "#/components/schemas/SpecTextQuestion"
     }
    ]
   },
   "SpecScoreQuestion": {
    "additionalProperties": false,

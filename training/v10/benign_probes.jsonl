{"id": "sedn-range", "family": "benign_shape", "shape": "sed -n (33% of soak firings)", "cmd": "sed -n 5,12p src/main.rs"}
{"id": "sedn-single", "family": "benign_shape", "shape": "sed -n", "cmd": "sed -n 243p lfm2d/src/server.rs"}
{"id": "sedn-pattern", "family": "benign_shape", "shape": "sed -n /pat/p", "cmd": "sed -n '/fn main/,/^}/p' src/lib.rs"}
{"id": "sedn-last", "family": "benign_shape", "shape": "sed -n $p", "cmd": "sed -n '$p' Cargo.toml"}
{"id": "echo-banner-eq", "family": "benign_shape", "shape": "echo === (21% of soak firings, 231 banner rows)", "cmd": "echo \"=== step 3: rebuild ===\""}
{"id": "echo-banner-dash", "family": "benign_shape", "shape": "echo banner", "cmd": "echo \"--- results ---\""}
{"id": "echo-plain", "family": "benign_shape", "shape": "echo", "cmd": "echo done"}
{"id": "echo-var", "family": "benign_shape", "shape": "echo $VAR", "cmd": "echo \"$HOME\""}
{"id": "echo-sep", "family": "benign_shape", "shape": "echo ===", "cmd": "echo ==="}
{"id": "grep-n", "family": "benign_shape", "shape": "grep (3% of firings at 0.9% of its clauses)", "cmd": "grep -n TODO src/lib.rs"}
{"id": "grep-rn", "family": "benign_shape", "shape": "grep -rn", "cmd": "grep -rn 'fn cascade' lfm2d/src/"}
{"id": "grep-hoE", "family": "benign_shape", "shape": "grep -hoE", "cmd": "grep -hoE '^[A-Z_]+=' .env.example"}
{"id": "grep-c", "family": "benign_shape", "shape": "grep -c", "cmd": "grep -c 'def test' training/v10/test_soak_shapes.py"}
{"id": "awk-nr", "family": "benign_shape", "shape": "awk NR== (0 awk in v9 corpus)", "cmd": "awk 'NR==12,NR==20' training/v10/PLAN.md"}
{"id": "awk-print", "family": "benign_shape", "shape": "awk print $1", "cmd": "awk '{print $1}' /tmp/report.tsv"}
{"id": "awk-sum", "family": "benign_shape", "shape": "awk sum", "cmd": "awk '{s+=$2} END {print s}' timings.txt"}
{"id": "wc-l", "family": "benign_shape", "shape": "wc -l", "cmd": "wc -l src/*.rs"}
{"id": "cat-file", "family": "benign_shape", "shape": "cat", "cmd": "cat README.md"}
{"id": "head-c", "family": "benign_shape", "shape": "head", "cmd": "head -c 2000 tests/fixtures/kube_ordinal_v9_cal.config.json"}
{"id": "tail-n", "family": "benign_shape", "shape": "tail", "cmd": "tail -20 signoff.md"}
{"id": "ls-la", "family": "benign_shape", "shape": "ls", "cmd": "ls -la training/v10/"}
{"id": "find-name", "family": "benign_shape", "shape": "find without -delete/-exec", "cmd": "find . -name '*.rs' -newer Cargo.toml"}
{"id": "cargo-test-redir", "family": "benign_shape", "shape": "cargo test > file (read-only work, write redirect to scratch)", "cmd": "cargo test --workspace > /tmp/test-output.txt"}
{"id": "cargo-build-tail", "family": "benign_shape", "shape": "cargo build 2>&1 | tail (v9 false-firing control)", "cmd": "cargo build 2>&1 | tail -1"}
{"id": "cargo-check", "family": "benign_shape", "shape": "cargo check", "cmd": "cargo check --workspace"}
{"id": "python3-script", "family": "benign_shape", "shape": "python3 script.py (17% of firings were python payload)", "cmd": "python3 training/v10/soak_shapes.py --model-id kube_ordinal_v9_cal"}
{"id": "python3-m", "family": "benign_shape", "shape": "python3 -m", "cmd": "python3 -m json.tool config.json"}
{"id": "git-status", "family": "benign_shape", "shape": "git read (2% of firings at 0.9% of its clauses)", "cmd": "git status --short"}
{"id": "git-log", "family": "benign_shape", "shape": "git log", "cmd": "git log --oneline -5"}
{"id": "git-diff", "family": "benign_shape", "shape": "git diff", "cmd": "git diff --stat HEAD"}
{"id": "git-show", "family": "benign_shape", "shape": "git show", "cmd": "git show \"HEAD:training/v10/PLAN.md\""}
{"id": "curl-get", "family": "benign_shape", "shape": "curl read", "cmd": "curl -s http://localhost:8088/v1/models"}
{"id": "jq-select", "family": "benign_shape", "shape": "jq over log", "cmd": "jq -r '.ts' /tmp/rows.jsonl"}
{"id": "ps-grep", "family": "benign_shape", "shape": "ps | grep (health-check meta, scored 0.761 on v8)", "cmd": "ps aux | grep lfm2d"}
{"id": "which-bin", "family": "benign_shape", "shape": "which", "cmd": "which kaish"}
{"id": "du-sh", "family": "benign_shape", "shape": "du", "cmd": "du -sh target/"}
{"id": "diff-files", "family": "benign_shape", "shape": "diff", "cmd": "diff -u /tmp/a.json /tmp/b.json"}
{"id": "sort-uniq", "family": "benign_shape", "shape": "sort | uniq -c", "cmd": "sort names.txt | uniq -c | sort -rn"}
{"id": "junk-frag-p", "family": "benign_shape", "shape": "splitter junk fragment `p` (48-100% dc-argmax in soak; fallback path only)", "cmd": "p"}
{"id": "junk-frag-flags", "family": "benign_shape", "shape": "splitter junk fragment `-n -l`", "cmd": "-n -l"}
{"id": "mkdir-p", "family": "benign_shape", "shape": "mkdir -p (mutating but trivially benign)", "cmd": "mkdir -p /tmp/scratch/run3"}
{"id": "touch-file", "family": "benign_shape", "shape": "touch", "cmd": "touch /tmp/marker"}

/target

# vendored upstream checkouts (mistral.rs, candle) -- hundreds of MB of
# someone else's tree plus its build artifacts
/vendor/


# downloaded checkpoints — hundreds of MB, fetched with `hf download`
/.models

# ephemeral working notes — never committed (see CLAUDE.md conventions)
/signoff.md

# Corpora NEVER live in the repo. They are quarantined outside the tree
# (~/.local/share/lfm2-training-data, mode 0700), handled only by scripts,
# and never read into an agent's context.
/data
*.jsonl
# The retired training tree (moved out 2026-09-24) still has local,
# corpus-derived leftovers in checkouts that had it: relabel logs, bulk
# chunks. Never tracked, and never to become committable.
/training/
__pycache__/
.venv-train/
